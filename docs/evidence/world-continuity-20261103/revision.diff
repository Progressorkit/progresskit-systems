--- before/assets/world-continuity.css
+++ after/assets/world-continuity.css
@@ -0,0 +1,26 @@
+/* One room, outside the scrolling content. Only the camera moves: no chapter
+   background, opacity gate, seam gradient or repeated section-sized plate. */
+.installation-world { position:fixed; inset:0; z-index:0; overflow:hidden; pointer-events:none; background:#050507; }
+.installation-world__architecture { position:absolute; inset:-8%; background:url('world/installation-chamber.webp') 65% 50%/cover no-repeat; opacity:.78; transform:translate3d(var(--world-far-x,0px),var(--world-far-y,0px),0) scale(var(--world-scale,1)); transform-origin:66% 48%; will-change:transform; }
+.installation-world__light { position:absolute; inset:-10%; background:radial-gradient(ellipse 50% 75% at 96% 58%,#57121e3b,transparent 80%),radial-gradient(ellipse 65% 30% at 44% 0%,#b3bfce12,transparent 78%),radial-gradient(ellipse 75% 28% at 64% 106%,#771b292e,transparent 83%),linear-gradient(90deg,#05050770,transparent 62%); transform:translate3d(var(--world-mid-x,0px),var(--world-mid-y,0px),0); }
+.installation-world .world-embers { position:absolute; inset:0; width:100%; height:100%; z-index:1; contain:strict; }
+
+/* Explicit surface contract neutralises the old chapter skins, including
+   their more-specific ID rules. Bounded objects keep their own materials. */
+body.luxury-world:has(.installation-world) #main { z-index:1; background:none; overflow-x:clip; overflow-y:visible; }
+body.luxury-world:has(.installation-world) #main::before { content:none; }
+body.luxury-world:has(.installation-world) #main > section:is(#start,#rdzen,#projekty,#uslugi,#proces,#ekosystem,#wydania,#o-mnie,#wyzwania,#technologie),
+body.luxury-world:has(.installation-world) > footer { background:none; border:0; box-shadow:none; overflow:visible; }
+body.luxury-world:has(.installation-world) #main > section:is(#start,#rdzen,#projekty,#uslugi,#proces,#ekosystem,#wydania,#o-mnie,#wyzwania,#technologie)::before,
+body.luxury-world:has(.installation-world) #main > section:is(#start,#rdzen,#projekty,#uslugi,#proces,#ekosystem,#wydania,#o-mnie,#wyzwania,#technologie)::after { content:none; }
+body.luxury-world:has(.installation-world) > footer { position:relative; z-index:1; }
+body.luxury-world:has(.installation-world) > footer::after { content:none; }
+/* The WebGL renderer clears to alpha. A mask would still erase the shared
+   particles/reflections around its edge and is no longer needed. */
+body.luxury-world:has(.installation-world) #projekty .showroom-scene { mask:none; -webkit-mask:none; background:none; }
+body.luxury-world:has(.installation-world) #projekty .showroom-heading { border-bottom:0; }
+
+@media(max-width:700px) { .installation-world__architecture { background-position:67% 50%; opacity:.64; } }
+@media(prefers-reduced-motion:reduce) { .installation-world__architecture,.installation-world__light { transform:none!important; will-change:auto; } }
+@media(forced-colors:active) { .installation-world { display:none; } }
+@media print { .installation-world { display:none; } }
