{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch API Core (Debugowanie)",
      "program": "${workspaceFolder}/apps/api-core/src/index.js",
      "restart": true,
      "console": "integratedTerminal",
      "protocol": "inspector",
      "cwd": "${workspaceFolder}/apps/api-core",
      "env": {
        "NODE_ENV": "development"
      }
    },
    {
      "type": "node",
      "request": "attach",
      "name": "Attach to pnpm dev (Port 9229)",
      "port": 9229,
      "skipFiles": ["<node_internals>/**"],
      "protocol": "inspector"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Uruchom Aktualny Plik (node)",
      "program": "${file}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
