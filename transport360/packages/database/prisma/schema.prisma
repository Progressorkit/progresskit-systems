datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PASSENGER
  DISPATCHER
  DRIVER
  ADMIN
}

enum OrderType {
  B2C
  B2B
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role     @default(PASSENGER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Carrier {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  vehicles  Vehicle[]
}

model Vehicle {
  id         String   @id @default(uuid())
  plate      String   @unique
  capacity   Int
  carrierId  String
  carrier    Carrier  @relation(fields: [carrierId], references: [id])
  createdAt  DateTime @default(now())
}

model Order {
  id           String    @id @default(uuid())
  type         OrderType
  title        String?
  passengerId  String?
  carrierId    String?
  originLat    Float
  originLng    Float
  destLat      Float
  destLng      Float
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Trip {
  id         String      @id @default(uuid())
  driverId   String
  vehicleId  String
  startAt    DateTime?
  endAt      DateTime?
  createdAt  DateTime    @default(now())
  driver     User        @relation(fields: [driverId], references: [id])
  vehicle    Vehicle     @relation(fields: [vehicleId], references: [id])
  stops      RouteStop[]
}

model RouteStop {
  id       String   @id @default(uuid())
  tripId   String
  seq      Int
  lat      Float
  lng      Float
  createdAt DateTime @default(now())
  trip     Trip     @relation(fields: [tripId], references: [id])
}

