datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

generator client {
 provider = "prisma-client-js"
}

enum Role {
 PASSENGER
 DISPATCHER
 DRIVER
 ADMIN
}

model User {
 id String @id @default(uuid())
 email String @unique
 password String
 role Role @default(PASSENGER)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}
